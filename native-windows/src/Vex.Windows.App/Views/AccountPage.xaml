<Page
    x:Class="Vex.Windows.App.Views.AccountPage"
    AutomationProperties.AutomationId="AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="600" Margin="24,12,24,24" HorizontalAlignment="Stretch" Spacing="12">
            <Grid x:Name="AccountSummaryPanel" Padding="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AccountInitials" VerticalAlignment="Center" HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Display" FontSize="19" FontWeight="Black"
                    Foreground="{StaticResource VexCyanLightBrush}" Text="V" AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" Margin="14,0,10,0" Spacing="4">
                    <TextBlock x:Name="AccountStatus" AutomationProperties.AutomationId="AccountPageTitle" FontFamily="Segoe UI Variable Display" FontSize="19"
                        FontWeight="Black" Foreground="{StaticResource VexTextBrush}" Text="Аккаунт VEX"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AccountPlanFact" FontSize="12" FontWeight="Bold"
                        Foreground="{StaticResource VexCyanLightBrush}" Text="Проверяем подписку" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AuthHintText" FontSize="11" FontWeight="SemiBold"
                        Foreground="{StaticResource VexMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="AccountAccessBadge" Grid.Column="2" Padding="10,6" VerticalAlignment="Center"
                    Background="#14FFFFFF" CornerRadius="16">
                    <TextBlock x:Name="AccountAccessBadgeText" FontSize="11" FontWeight="Black"
                        Foreground="{StaticResource VexSecondaryTextBrush}" Text="Проверка" />
                </Border>
            </Grid>

            <Border x:Name="BillingPanel" Padding="15,0,15,4" Visibility="Collapsed">
                <StackPanel Spacing="13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="BillingTitle" FontSize="16" FontWeight="Black"
                                Foreground="{StaticResource VexTextBrush}" Text="Подписка" />
                            <TextBlock x:Name="BillingSubtitle" FontSize="11" FontWeight="SemiBold"
                                Foreground="{StaticResource VexSecondaryTextBrush}"
                                Text="Оплата и управление подпиской — на сайте VEX" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="RefreshBillingButton" AutomationProperties.AutomationId="RefreshBillingButton" Grid.Column="1" Click="OnRefreshBillingClick"
                            Style="{StaticResource VexQuietButtonStyle}" Padding="8" VerticalAlignment="Center"
                            AutomationProperties.Name="Обновить подписку" ToolTipService.ToolTip="Обновить подписку">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Button x:Name="CheckoutButton" AutomationProperties.AutomationId="AccountCheckoutButton" Click="OnOpenBillingWebsiteClick"
                        Style="{StaticResource VexProminentButtonStyle}" HorizontalAlignment="Stretch" MinHeight="42"
                        AutomationProperties.Name="Оплатить подписку на сайте VEX">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8C7;" FontSize="14" />
                            <TextBlock Text="Оплатить на сайте" FontSize="12" FontWeight="Black" />
                        </StackPanel>
                    </Button>
                    <Expander Header="Подробности подписки" HorizontalAlignment="Stretch" Background="Transparent"
                        BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="7">
                            <TextBlock x:Name="BillingPlan" FontSize="12" Foreground="{StaticResource VexSecondaryTextBrush}" Text="Тариф: —" TextWrapping="Wrap" />
                            <TextBlock x:Name="BillingAccess" FontSize="12" Foreground="{StaticResource VexSecondaryTextBrush}" Text="Доступ: —" TextWrapping="Wrap" />
                            <TextBlock x:Name="BillingPeriod" FontSize="12" Foreground="{StaticResource VexMutedBrush}" Text="Период: —" TextWrapping="Wrap" />
                            <TextBlock x:Name="AccountStatusFact" FontSize="12" Foreground="{StaticResource VexSecondaryTextBrush}" Text="Статус: —" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border x:Name="PaymentHistoryPanel" Padding="15" Background="#7508191D" CornerRadius="16" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="16" FontWeight="Black" Foreground="{StaticResource VexTextBrush}" Text="Оплаты" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource VexSecondaryTextBrush}" Text="Последние операции по подписке" />
                    </StackPanel>
                    <Border x:Name="PaymentHistoryEmpty" Padding="11" Background="#0AFFFFFF" CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" Background="#2122D3EE" BorderBrush="#3322D3EE" BorderThickness="1" CornerRadius="8">
                                <FontIcon Glyph="&#xE7C3;" FontSize="17" Foreground="{StaticResource VexCyanBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="Оплат пока нет" FontSize="13" FontWeight="Black" Foreground="{StaticResource VexTextBrush}" />
                                <TextBlock Text="Покупки и продления появятся здесь." FontSize="11" FontWeight="SemiBold"
                                    Foreground="{StaticResource VexSecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListView x:Name="PaymentHistoryList" AutomationProperties.AutomationId="PaymentHistoryList"
                        Background="Transparent" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPaymentHistoryItemClick"
                        HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="52" />
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="10" ToolTipService.ToolTip="Открыть оплату в кабинете VEX">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" VerticalAlignment="Center" Background="#1A22D3EE" CornerRadius="14">
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="13" Foreground="{StaticResource VexCyanBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock FontSize="14" FontWeight="Black" Foreground="{StaticResource VexTextBrush}" Text="{Binding Amount}" />
                                            <Border Padding="7,3" Background="{Binding StatusBackground}" CornerRadius="12">
                                                <TextBlock FontSize="10" FontWeight="Black" Foreground="{Binding StatusForeground}" Text="{Binding Status}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource VexSecondaryTextBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10" FontWeight="Bold"
                                        Foreground="{StaticResource VexMutedBrush}" Text="{Binding Date}" />
                                    <FontIcon Grid.Column="3" Glyph="&#xE8A7;" FontSize="11" Foreground="{StaticResource VexMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Expander x:Name="DeviceUsagePanel" Header="Устройства и трафик" Background="#7508191D" BorderThickness="0"
                CornerRadius="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="DeviceUsageSummary" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource VexSecondaryTextBrush}"
                        Text="Загружаем устройства." TextWrapping="Wrap" />
                    <ListView x:Name="DeviceUsageList" AutomationProperties.AutomationId="DeviceUsageList" Background="Transparent"
                        SelectionMode="None" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" FontSize="17" Foreground="{StaticResource VexCyanBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock FontSize="13" FontWeight="Black" Foreground="{StaticResource VexTextBrush}" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource VexSecondaryTextBrush}" Text="{Binding Meta}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource VexMutedBrush}" Text="{Binding Usage}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VexMutedBrush}" Text="{Binding Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Expander>

            <StackPanel x:Name="LoginBrandPanel" Margin="0,16,0,6" HorizontalAlignment="Center" Spacing="10">
                <Image Source="ms-appx:///Assets/vex-logo-header.png" Width="86" Height="86" AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <TextBlock Text="VEX" FontFamily="Segoe UI Variable Display" FontSize="36" FontWeight="Black" Foreground="{StaticResource VexTextBrush}" />
                    <Border Padding="14,6" Background="#1F22D3EE" BorderBrush="#7522D3EE" BorderThickness="1" CornerRadius="18" VerticalAlignment="Center">
                        <TextBlock Text="Team" FontSize="14" FontWeight="Black" Foreground="{StaticResource VexCyanBrush}" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <Border x:Name="AuthPanel" MaxWidth="430" HorizontalAlignment="Stretch" Padding="20" Background="#B308191D"
                BorderBrush="#3D22D3EE" BorderThickness="1" CornerRadius="22">
                <StackPanel Spacing="15">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="AuthHeadingText" AutomationProperties.AutomationId="AccountSignInTitle" HorizontalAlignment="Center" FontSize="25" FontWeight="Black"
                            Foreground="{StaticResource VexTextBrush}" Text="Вход в VEX" />
                        <TextBlock x:Name="AuthSubtitleText" FontSize="13" FontWeight="Bold" Foreground="{StaticResource VexSecondaryTextBrush}"
                            Text="Продолжите в браузере." TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border x:Name="BrowserWaitingPanel" Padding="14" Background="#2E000000" BorderBrush="#3D22D3EE"
                        BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing Width="17" Height="17" IsActive="True" Foreground="{StaticResource VexCyanBrush}" />
                            <TextBlock Text="Ждем подтверждение в браузере" FontSize="13" FontWeight="Black" Foreground="{StaticResource VexTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SignInStatusText" FontSize="12" Foreground="{StaticResource VexSecondaryTextBrush}" TextWrapping="Wrap" />
                    <Button x:Name="GoogleSignInButton" AutomationProperties.AutomationId="GoogleSignInButton" Click="OnGoogleSignInClick"
                        Content="Войти через Google" HorizontalAlignment="Stretch" MinHeight="52" FontSize="16" Style="{StaticResource VexGlassButtonStyle}" />
                    <Button x:Name="UnlockSessionButton" AutomationProperties.AutomationId="UnlockSessionButton" Click="OnUnlockSessionClick" Content="Открыть сохраненную сессию"
                        HorizontalAlignment="Stretch" MinHeight="52" FontSize="16" Style="{StaticResource VexProminentButtonStyle}" Visibility="Collapsed" />
                    <Button x:Name="WebsiteSignInButton" AutomationProperties.AutomationId="WebsiteSignInButton" Click="OnWebsiteSignInClick"
                        Content="Войти через сайт" HorizontalAlignment="Stretch" MinHeight="52" FontSize="16" Style="{StaticResource VexProminentButtonStyle}" />
                    <StackPanel x:Name="RegistrationPanel" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <TextBlock Text="Нет аккаунта?" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource VexSecondaryTextBrush}" />
                        <Button x:Name="WebsiteRegisterButton" AutomationProperties.AutomationId="WebsiteRegisterButton" Click="OnWebsiteRegisterClick" Content="Зарегистрироваться"
                            Background="Transparent" BorderThickness="0" Padding="0,7" FontSize="12" FontWeight="Black" Foreground="{StaticResource VexCyanLightBrush}" />
                    </StackPanel>
                    <Button x:Name="CancelWebsiteAuthButton" AutomationProperties.AutomationId="CancelWebsiteAuthButton" Click="OnCancelWebsiteAuthClick" Content="Отменить"
                        HorizontalAlignment="Stretch" MinHeight="36" Style="{StaticResource VexGlassButtonStyle}" Visibility="Collapsed" />
                    <Expander x:Name="EmailLoginExpander" Header="Войти по email" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="EmailOtpHintText" FontSize="12" Foreground="{StaticResource VexSecondaryTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                            <TextBox x:Name="EmailInput" Header="Email" InputScope="EmailSmtpAddress" PlaceholderText="name@example.com" />
                            <PasswordBox x:Name="PasswordInput" Header="Пароль" PasswordRevealMode="Peek" />
                            <TextBox x:Name="EmailOtpCodeInput" Header="Код из письма" InputScope="Text" MaxLength="32" PlaceholderText="Код из письма" Visibility="Collapsed" />
                            <StackPanel Spacing="8">
                                <Button x:Name="SignInButton" Click="OnSignInClick" Content="Войти с паролем" HorizontalAlignment="Stretch" Style="{StaticResource VexGlassButtonStyle}" />
                                <Button x:Name="RequestOtpButton" Click="OnRequestOtpClick" Content="Получить код" HorizontalAlignment="Stretch" Style="{StaticResource VexGlassButtonStyle}" />
                                <Button x:Name="ConfirmOtpButton" Click="OnConfirmOtpClick" Content="Войти по коду" HorizontalAlignment="Stretch" Style="{StaticResource VexProminentButtonStyle}" Visibility="Collapsed" />
                                <Button x:Name="ResendOtpButton" Click="OnRequestOtpClick" Content="Новый код" HorizontalAlignment="Stretch" Style="{StaticResource VexGlassButtonStyle}" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <StackPanel Padding="15,4" Orientation="Horizontal" Spacing="10">
                <Button x:Name="SignOutButton" AutomationProperties.AutomationId="SignOutButton" Click="OnSignOutClick" Content="Выйти из аккаунта" Style="{StaticResource VexGlassButtonStyle}" Visibility="Collapsed" />
                <ProgressRing x:Name="BusyIndicator" Width="20" Height="20" Foreground="{StaticResource VexCyanBrush}" IsActive="False" Visibility="Collapsed" />
            </StackPanel>
            <InfoBar x:Name="AccountNotice" IsClosable="True" IsOpen="False" Title="VEX VPN" />
        </StackPanel>
    </ScrollViewer>
</Page>
