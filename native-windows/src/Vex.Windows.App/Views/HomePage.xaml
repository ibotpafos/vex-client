<Page
    x:Class="Vex.Windows.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1120"
                Margin="26,0,26,8"
                HorizontalAlignment="Stretch"
                Spacing="8">
                <InfoBar
                    x:Name="FoundationNotice"
                    IsClosable="True"
                    IsOpen="False"
                    Message=""
                    Severity="Informational"
                    Title="VEX VPN" />

                <Grid
                    x:Name="FocusPulseHero"
                    Height="282"
                    MinWidth="620">
                    <Ellipse
                        Width="410"
                        Height="410"
                        Opacity="0.42"
                        Stroke="#1622D3EE"
                        StrokeThickness="1" />
                    <Ellipse
                        Width="330"
                        Height="330"
                        Opacity="0.55"
                        Stroke="#2022D3EE"
                        StrokeThickness="1" />
                    <Ellipse
                        Width="250"
                        Height="250"
                        Opacity="0.75"
                        Stroke="#2822D3EE"
                        StrokeThickness="1" />

                    <Border
                        Width="176"
                        Height="96"
                        Margin="22,0,0,12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#B3071113"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        CornerRadius="17">
                        <Grid Padding="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="34"
                                Height="34"
                                VerticalAlignment="Top"
                                BorderBrush="{StaticResource VexCyanBrush}"
                                BorderThickness="2"
                                CornerRadius="17">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{StaticResource VexCyanBrush}"
                                    Glyph="&#xE74B;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource VexSecondaryTextBrush}"
                                    Text="Получено" />
                                <TextBlock
                                    x:Name="ReceivedText"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="20"
                                    FontWeight="Black"
                                    Foreground="{StaticResource VexTextBrush}"
                                    Text="0 Б" />
                            </StackPanel>
                            <Polyline
                                Grid.ColumnSpan="2"
                                Margin="0,50,0,0"
                                Points="0,18 20,14 42,17 62,8 84,13 108,5 136,10"
                                Stroke="#B87EE9F5"
                                StrokeThickness="1.5" />
                        </Grid>
                    </Border>

                    <Border
                        Width="176"
                        Height="96"
                        Margin="0,0,22,12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#B3071113"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        CornerRadius="17">
                        <Grid Padding="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="34"
                                Height="34"
                                VerticalAlignment="Top"
                                BorderBrush="{StaticResource VexCyanBrush}"
                                BorderThickness="2"
                                CornerRadius="17">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{StaticResource VexCyanBrush}"
                                    Glyph="&#xE74A;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource VexSecondaryTextBrush}"
                                    Text="Отправлено" />
                                <TextBlock
                                    x:Name="SentText"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="20"
                                    FontWeight="Black"
                                    Foreground="{StaticResource VexTextBrush}"
                                    Text="0 Б" />
                            </StackPanel>
                            <Polyline
                                Grid.ColumnSpan="2"
                                Margin="0,50,0,0"
                                Points="0,18 20,14 42,17 62,8 84,13 108,5 136,10"
                                Stroke="#B87EE9F5"
                                StrokeThickness="1.5" />
                        </Grid>
                    </Border>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <Button
                            x:Name="PowerButton"
                            Width="154"
                            Height="154"
                            Padding="0"
                            AutomationProperties.AutomationId="PowerButton"
                            AutomationProperties.Name="Подключить VPN"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnPowerButtonClick"
                            CornerRadius="77"
                            UseSystemFocusVisuals="False">
                            <Grid>
                                <Ellipse
                                    Fill="#E6071113"
                                    Stroke="#3022D3EE"
                                    StrokeThickness="12" />
                                <Ellipse
                                    Margin="8"
                                    Stroke="{StaticResource VexCyanBrush}"
                                    StrokeThickness="5" />
                                <FontIcon
                                    x:Name="PowerGlyph"
                                    FontSize="48"
                                    Foreground="{StaticResource VexCyanBrush}"
                                    Glyph="&#xE7E8;" />
                                <ProgressRing
                                    x:Name="PowerBusyIndicator"
                                    Width="126"
                                    Height="126"
                                    Foreground="{StaticResource VexCyanLightBrush}"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <TextBlock
                            x:Name="PowerButtonText"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="21"
                            FontWeight="Black"
                            Foreground="{StaticResource VexTextBrush}"
                            Text="Не подключено" />
                        <TextBlock
                            x:Name="StatusText"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource VexSecondaryTextBrush}"
                            Text="Нажмите, чтобы подключить VPN" />
                    </StackPanel>
                </Grid>

                <Grid Margin="2,0,2,2">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="20"
                        FontWeight="Black"
                        Foreground="{StaticResource VexTextBrush}"
                        Text="Локации" />
                    <Button
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="ServerPickerButton"
                        Click="OnServerPickerClick"
                        Style="{StaticResource VexQuietButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource VexSecondaryTextBrush}"
                                Text="Все" />
                            <FontIcon
                                FontSize="12"
                                Foreground="{StaticResource VexSecondaryTextBrush}"
                                Glyph="&#xE76C;" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView
                    x:Name="LocationCarousel"
                    Height="94"
                    AutomationProperties.Name="Быстрый выбор локации"
                    Background="Transparent"
                    IsItemClickEnabled="False"
                    SelectionMode="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,10,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="UseSystemFocusVisuals" Value="False" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="300"
                                Height="82"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnLocationCardClick"
                                PointerEntered="OnLocationCardPointerEntered"
                                PointerExited="OnLocationCardPointerExited"
                                Tag="{Binding Location}">
                                <Border
                                    Padding="14,10"
                                    Background="{Binding CardBackground}"
                                    BorderBrush="{Binding CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                    <Grid>
                                        <Path
                                            x:Name="CountryArtwork"
                                            Width="88"
                                            Height="88"
                                            Margin="0,-3,76,-3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Data="{Binding CountryGeometry}"
                                            Fill="{Binding CountryFill}"
                                            Opacity="{Binding CountryOpacity}"
                                            RenderTransformOrigin="0.5,0.5"
                                            Stretch="Uniform"
                                            Stroke="{Binding CountryStroke}"
                                            StrokeThickness="0.75">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="30"
                                                Height="20"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource VexSecondaryTextBrush}"
                                                    Text="{Binding FlagEmoji}" />
                                                <Border
                                                    Background="#FF071113"
                                                    BorderBrush="#20FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <Image
                                                        Source="{Binding FlagAsset}"
                                                        Stretch="UniformToFill" />
                                                </Border>
                                            </Grid>
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    FontFamily="Segoe UI Variable Display"
                                                    FontSize="15"
                                                    FontWeight="Black"
                                                    Foreground="{StaticResource VexTextBrush}"
                                                    Text="{Binding DisplayName}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource VexSecondaryTextBrush}"
                                                    Text="{Binding AvailabilityText}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="9">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="Black"
                                                    Foreground="{StaticResource VexCyanLightBrush}"
                                                    Text="{Binding LatencyText}" />
                                                <Border
                                                    Width="17"
                                                    Height="17"
                                                    Background="{Binding SelectionFill}"
                                                    BorderBrush="{Binding SelectionStroke}"
                                                    BorderThickness="2"
                                                    CornerRadius="9">
                                                    <FontIcon
                                                        FontSize="9"
                                                        Foreground="{StaticResource VexBackgroundBrush}"
                                                        Glyph="{Binding SelectionGlyph}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="FooterMessage"
                    Height="18"
                    Margin="5,0"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource VexSecondaryTextBrush}"
                    Text="" />
            </StackPanel>
        </ScrollViewer>

        <ContentDialog
            x:Name="ServerPickerDialog"
            AutomationProperties.Name="Выбор сервера VPN"
            Background="#FF031B1E"
            CornerRadius="24"
            DefaultButton="None"
            RequestedTheme="Dark">
            <Grid
                Width="420"
                MinHeight="430"
                Padding="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource VexEyebrowStyle}" Text="VEX VPN" />
                        <TextBlock
                            FontFamily="Segoe UI Variable Display"
                            FontSize="28"
                            FontWeight="Black"
                            Foreground="{StaticResource VexTextBrush}"
                            Text="Серверы" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{StaticResource VexSecondaryTextBrush}"
                            Text="Выберите ближайший стабильный узел."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Закрыть выбор сервера"
                        Click="OnCloseServerPickerClick"
                        Content="✕"
                        CornerRadius="12"
                        FontSize="18"
                        Style="{StaticResource VexGlassButtonStyle}" />
                </Grid>

                <Button
                    Grid.Row="1"
                    Margin="0,18,0,10"
                    Padding="12,10"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Автоматический выбор сервера"
                    Click="OnAutoServerClick"
                    Style="{StaticResource VexGlassButtonStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="40"
                            Height="40"
                            Background="#2522D3EE"
                            CornerRadius="10">
                            <FontIcon
                                FontSize="18"
                                Foreground="{StaticResource VexCyanBrush}"
                                Glyph="&#xE945;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                FontSize="15"
                                FontWeight="Black"
                                Foreground="{StaticResource VexTextBrush}"
                                Text="Автовыбор" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource VexSecondaryTextBrush}"
                                Text="VEX выберет лучший сервер" />
                        </StackPanel>
                        <FontIcon
                            x:Name="AutoServerSelectionIcon"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="{StaticResource VexCyanBrush}"
                            Glyph="&#xE73E;" />
                    </Grid>
                </Button>

                <ListView
                    x:Name="LocationPicker"
                    Grid.Row="2"
                    AutomationProperties.Name="Доступные серверы"
                    HorizontalAlignment="Stretch"
                    IsItemClickEnabled="True"
                    ItemClick="OnLocationItemClick"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,10" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="20" Text="{Binding FlagEmoji}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Black"
                                        Foreground="{StaticResource VexTextBrush}"
                                        Text="{Binding City}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource VexSecondaryTextBrush}"
                                        Text="{Binding Availability}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource VexCyanLightBrush}"
                                    Text="{Binding LatencyMs}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="LocationCapabilityText"
                    Grid.Row="2"
                    Margin="12,8"
                    VerticalAlignment="Bottom"
                    FontSize="11"
                    Foreground="{StaticResource VexSecondaryTextBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <RadioButton x:Name="AutoServerRadio" Visibility="Collapsed" />
                <RadioButton x:Name="ManualServerRadio" Visibility="Collapsed" />
                <Button
                    x:Name="ApplyLocationButton"
                    Click="OnApplyLocationClick"
                    Visibility="Collapsed" />
            </Grid>
        </ContentDialog>
    </Grid>
</Page>
