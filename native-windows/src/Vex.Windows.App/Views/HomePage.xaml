<Page
    x:Class="Vex.Windows.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <CollectionViewSource x:Key="ServerCatalogSource" IsSourceGrouped="True" ItemsPath="Rows" />
        <DataTemplate x:Key="ServerRowTemplate">
            <Grid Padding="8,10" ColumnSpacing="10" AutomationProperties.Name="{Binding AccessibleName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="19" Text="{Binding FlagEmoji}" />
                <StackPanel Grid.Column="1" Spacing="3" Opacity="{Binding AvailabilityOpacity}">
                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource VexTextBrush}" Text="{Binding Title}" />
                    <TextBlock FontSize="10" Foreground="{StaticResource VexSecondaryTextBrush}" Text="{Binding LocationId}" />
                    <TextBlock FontSize="11" Foreground="{StaticResource VexSecondaryTextBrush}" Text="{Binding StatusText}" />
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                    Foreground="{StaticResource VexCyanLightBrush}" Text="{Binding LatencyText}" />
                <Button Grid.Column="3" Width="34" Height="34" Padding="4" VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding FavoriteHelp}" ToolTipService.ToolTip="{Binding FavoriteHelp}"
                    Click="OnFavoriteLocationClick" Tag="{Binding Location}" Style="{StaticResource VexQuietButtonStyle}">
                    <FontIcon FontSize="16" Glyph="{Binding FavoriteGlyph}" Foreground="{StaticResource VexCyanBrush}" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1120"
                Margin="26,0,26,8"
                HorizontalAlignment="Stretch"
                Spacing="8">
                <InfoBar
                    x:Name="FoundationNotice"
                    IsClosable="True"
                    IsOpen="False"
                    Message=""
                    Severity="Informational"
                    Title="VEX VPN" />

                <Grid
                    x:Name="FocusPulseHero"
                    Height="282"
                    MinWidth="620">
                    <Ellipse
                        Width="410"
                        Height="410"
                        Opacity="0.42"
                        Stroke="#1622D3EE"
                        StrokeThickness="1" />
                    <Ellipse
                        Width="330"
                        Height="330"
                        Opacity="0.55"
                        Stroke="#2022D3EE"
                        StrokeThickness="1" />
                    <Ellipse
                        Width="250"
                        Height="250"
                        Opacity="0.75"
                        Stroke="#2822D3EE"
                        StrokeThickness="1" />

                    <Border
                        Width="176"
                        Height="96"
                        Margin="22,0,0,12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#B3071113"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        CornerRadius="17">
                        <Grid Padding="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="34"
                                Height="34"
                                VerticalAlignment="Top"
                                BorderBrush="{StaticResource VexCyanBrush}"
                                BorderThickness="2"
                                CornerRadius="17">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{StaticResource VexCyanBrush}"
                                    Glyph="&#xE74B;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource VexSecondaryTextBrush}"
                                    Text="Получено" />
                                <TextBlock
                                    x:Name="ReceivedText"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="20"
                                    FontWeight="Black"
                                    Foreground="{StaticResource VexTextBrush}"
                                    Text="0 Б" />
                            </StackPanel>
                            <Polyline
                                Grid.ColumnSpan="2"
                                Margin="0,50,0,0"
                                Points="0,18 20,14 42,17 62,8 84,13 108,5 136,10"
                                Stroke="#B87EE9F5"
                                StrokeThickness="1.5" />
                        </Grid>
                    </Border>

                    <Border
                        Width="176"
                        Height="96"
                        Margin="0,0,22,12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#B3071113"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        CornerRadius="17">
                        <Grid Padding="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="34"
                                Height="34"
                                VerticalAlignment="Top"
                                BorderBrush="{StaticResource VexCyanBrush}"
                                BorderThickness="2"
                                CornerRadius="17">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{StaticResource VexCyanBrush}"
                                    Glyph="&#xE74A;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource VexSecondaryTextBrush}"
                                    Text="Отправлено" />
                                <TextBlock
                                    x:Name="SentText"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="20"
                                    FontWeight="Black"
                                    Foreground="{StaticResource VexTextBrush}"
                                    Text="0 Б" />
                            </StackPanel>
                            <Polyline
                                Grid.ColumnSpan="2"
                                Margin="0,50,0,0"
                                Points="0,18 20,14 42,17 62,8 84,13 108,5 136,10"
                                Stroke="#B87EE9F5"
                                StrokeThickness="1.5" />
                        </Grid>
                    </Border>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <Button
                            x:Name="PowerButton"
                            Width="154"
                            Height="154"
                            Padding="0"
                            AutomationProperties.AutomationId="PowerButton"
                            AutomationProperties.Name="Подключить VPN"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnPowerButtonClick"
                            CornerRadius="77"
                            UseSystemFocusVisuals="False">
                            <Grid>
                                <Ellipse
                                    Fill="#E6071113"
                                    Stroke="#3022D3EE"
                                    StrokeThickness="12" />
                                <Ellipse
                                    Margin="8"
                                    Stroke="{StaticResource VexCyanBrush}"
                                    StrokeThickness="5" />
                                <FontIcon
                                    x:Name="PowerGlyph"
                                    FontSize="48"
                                    Foreground="{StaticResource VexCyanBrush}"
                                    Glyph="&#xE7E8;" />
                                <ProgressRing
                                    x:Name="PowerBusyIndicator"
                                    Width="126"
                                    Height="126"
                                    Foreground="{StaticResource VexCyanLightBrush}"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <TextBlock
                            x:Name="PowerButtonText"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="21"
                            FontWeight="Black"
                            Foreground="{StaticResource VexTextBrush}"
                            Text="Не подключено" />
                        <TextBlock
                            x:Name="StatusText"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource VexSecondaryTextBrush}"
                            Text="Нажмите, чтобы подключить VPN" />
                    </StackPanel>
                </Grid>

                <Grid Margin="2,0,2,2">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="20"
                        FontWeight="Black"
                        Foreground="{StaticResource VexTextBrush}"
                        Text="Локации" />
                    <Button
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="ServerPickerButton"
                        Click="OnServerPickerClick"
                        Style="{StaticResource VexQuietButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource VexSecondaryTextBrush}"
                                Text="Все" />
                            <FontIcon
                                FontSize="12"
                                Foreground="{StaticResource VexSecondaryTextBrush}"
                                Glyph="&#xE76C;" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView
                    x:Name="LocationCarousel"
                    Height="94"
                    AutomationProperties.Name="Быстрый выбор локации"
                    Background="Transparent"
                    IsItemClickEnabled="False"
                    SelectionMode="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,10,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="UseSystemFocusVisuals" Value="False" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="300"
                                Height="82"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnLocationCardClick"
                                PointerEntered="OnLocationCardPointerEntered"
                                PointerExited="OnLocationCardPointerExited"
                                Tag="{Binding Group}" AutomationProperties.Name="{Binding AccessibleName}">
                                <Border
                                    Padding="14,10"
                                    Background="{Binding CardBackground}"
                                    BorderBrush="{Binding CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                    <Grid>
                                        <Path
                                            x:Name="CountryArtwork"
                                            Width="88"
                                            Height="88"
                                            Margin="0,-3,76,-3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Data="{Binding CountryGeometry}"
                                            Fill="{Binding CountryFill}"
                                            Opacity="{Binding CountryOpacity}"
                                            RenderTransformOrigin="0.5,0.5"
                                            Stretch="Uniform"
                                            Stroke="{Binding CountryStroke}"
                                            StrokeThickness="0.75">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="30"
                                                Height="20"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource VexSecondaryTextBrush}"
                                                    Text="{Binding FlagEmoji}" />
                                                <Border
                                                    Background="#FF071113"
                                                    Visibility="{Binding FlagAssetVisibility}"
                                                    BorderBrush="#20FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <Image
                                                        Source="{Binding FlagAsset}"
                                                        Stretch="UniformToFill" />
                                                </Border>
                                            </Grid>
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    FontFamily="Segoe UI Variable Display"
                                                    FontSize="15"
                                                    FontWeight="Black"
                                                    Foreground="{StaticResource VexTextBrush}"
                                                    Text="{Binding DisplayName}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource VexSecondaryTextBrush}"
                                                    Text="{Binding AvailabilityText}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="9">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="Black"
                                                    Foreground="{StaticResource VexCyanLightBrush}"
                                                    Text="{Binding LatencyText}" />
                                                <Border
                                                    Width="17"
                                                    Height="17"
                                                    Background="{Binding SelectionFill}"
                                                    BorderBrush="{Binding SelectionStroke}"
                                                    BorderThickness="2"
                                                    CornerRadius="9">
                                                    <FontIcon
                                                        FontSize="9"
                                                        Foreground="{StaticResource VexBackgroundBrush}"
                                                        Glyph="{Binding SelectionGlyph}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="FooterMessage"
                    Height="18"
                    Margin="5,0"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource VexSecondaryTextBrush}"
                    Text="" />
            </StackPanel>
        </ScrollViewer>

        <ContentDialog
            x:Name="ServerPickerDialog"
            AutomationProperties.Name="Выбор сервера VPN"
            Background="#FF031B1E"
            CornerRadius="24"
            DefaultButton="None"
            RequestedTheme="Dark">
            <Grid Width="440" MinHeight="530" Padding="4" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource VexEyebrowStyle}" Text="VEX VPN" />
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="Black"
                            Foreground="{StaticResource VexTextBrush}" Text="Все серверы" />
                        <TextBlock x:Name="CatalogCountText" FontSize="12" Foreground="{StaticResource VexSecondaryTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="42" Height="42" VerticalAlignment="Top"
                        AutomationProperties.Name="Закрыть выбор сервера" Click="OnCloseServerPickerClick"
                        Content="✕" CornerRadius="12" FontSize="18" Style="{StaticResource VexGlassButtonStyle}" />
                </Grid>
                <Button x:Name="AutoServerButton" Grid.Row="1" Padding="12,10" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Автоматический выбор сервера" Click="OnAutoServerClick"
                    Style="{StaticResource VexGlassButtonStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" FontSize="20" Foreground="{StaticResource VexCyanBrush}" Glyph="&#xE945;" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource VexTextBrush}" Text="Автовыбор" />
                            <TextBlock FontSize="11" Foreground="{StaticResource VexSecondaryTextBrush}" Text="VEX выберет лучший сервер" />
                        </StackPanel>
                        <FontIcon x:Name="AutoServerSelectionIcon" Grid.Column="2" VerticalAlignment="Center"
                            FontSize="15" Foreground="{StaticResource VexCyanBrush}" Glyph="&#xE73E;" />
                    </Grid>
                </Button>
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServerSearchBox" PlaceholderText="Поиск страны или сервера"
                        AutomationProperties.Name="Поиск страны или сервера" TextChanged="OnServerSearchTextChanged"
                        KeyDown="OnServerSearchKeyDown" />
                    <Button x:Name="RefreshCatalogButton" Grid.Column="1" Width="42" Height="38"
                        AutomationProperties.Name="Обновить серверы" ToolTipService.ToolTip="Обновить серверы"
                        Click="OnRefreshCatalogClick" Style="{StaticResource VexGlassButtonStyle}">
                        <Grid>
                            <FontIcon x:Name="RefreshCatalogIcon" Glyph="&#xE72C;" FontSize="16" />
                            <ProgressRing x:Name="CatalogLoadingIndicator" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </Grid>
                <ComboBox x:Name="ServerFilterPicker" Grid.Row="3" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" AutomationProperties.Name="Фильтр серверов"
                    SelectionChanged="OnServerFilterChanged">
                    <ComboBoxItem Content="Все" Tag="all" />
                    <ComboBoxItem Content="Быстрые" Tag="fastest" />
                    <ComboBoxItem Content="Избранные" Tag="favorites" />
                    <ComboBoxItem Content="Доступные" Tag="available" />
                </ComboBox>
                <Grid Grid.Row="4">
                    <ListView x:Name="LocationPicker" MinHeight="210" MaxHeight="310"
                        AutomationProperties.Name="Серверы по странам" HorizontalAlignment="Stretch"
                        IsItemClickEnabled="True" ItemClick="OnLocationItemClick" KeyDown="OnLocationPickerKeyDown"
                        SelectionMode="Single" ItemTemplate="{StaticResource ServerRowTemplate}">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,12,8,4">
                                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="{StaticResource VexTextBrush}" Text="{Binding Title}" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                    </ListView>
                    <TextBlock x:Name="CatalogEmptyText" Margin="14,24" HorizontalAlignment="Center"
                        TextAlignment="Center" FontSize="13" Foreground="{StaticResource VexSecondaryTextBrush}"
                        TextWrapping="Wrap" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="LocationCapabilityText" Grid.Row="5" Margin="8,0" FontSize="11"
                    Foreground="{StaticResource VexSecondaryTextBrush}" TextWrapping="Wrap" />
                <RadioButton x:Name="AutoServerRadio" Visibility="Collapsed" />
                <RadioButton x:Name="ManualServerRadio" Visibility="Collapsed" />
                <Button x:Name="ApplyLocationButton" Click="OnApplyLocationClick" Visibility="Collapsed" />
            </Grid>
        </ContentDialog>
    </Grid>
</Page>
