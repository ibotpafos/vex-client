<Page
    x:Class="Vex.Windows.App.Views.SupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="SupportPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
        <Grid HorizontalAlignment="Stretch">
        <StackPanel MaxWidth="600" Margin="24,12,24,24" HorizontalAlignment="Stretch" Spacing="12">
            <Grid Padding="15,10" ColumnSpacing="13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" Background="#2122D3EE" BorderBrush="#3322D3EE" BorderThickness="1" CornerRadius="12">
                    <FontIcon Glyph="&#xE8F2;" FontSize="21" Foreground="{StaticResource VexCyanBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Поддержка" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="Black"
                        AutomationProperties.AutomationId="SupportPageTitle" Foreground="{StaticResource VexTextBrush}" />
                    <TextBlock x:Name="SupportStatusText" FontSize="11" FontWeight="SemiBold"
                        Foreground="{StaticResource VexMutedBrush}" Text="Поможем с подключением и аккаунтом" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button x:Name="RefreshSupportButton" AutomationProperties.AutomationId="RefreshSupportButton"
                        AutomationProperties.Name="Обновить поддержку" Click="OnRefreshClick" Padding="8"
                        Style="{StaticResource VexQuietButtonStyle}" ToolTipService.ToolTip="Обновить поддержку">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <ProgressRing x:Name="BusyIndicator" Width="20" Height="20" Foreground="{StaticResource VexCyanBrush}"
                        IsActive="False" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <Button Click="OnOpenSupportWebsiteClick" AutomationProperties.AutomationId="SupportWebsiteButton"
                Style="{StaticResource VexGlassButtonStyle}" HorizontalAlignment="Stretch" MinHeight="42">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                    <TextBlock Text="Открыть поддержку на сайте" FontSize="12" FontWeight="Black" />
                    <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                </StackPanel>
            </Button>
            <InfoBar x:Name="SupportNotice" IsClosable="True" IsOpen="False" Title="VEX VPN" />

            <Border x:Name="SignInRequiredPanel" Padding="15" Background="#7508191D" CornerRadius="16">
                <StackPanel Spacing="11">
                    <TextBlock Text="Сначала войдите в аккаунт" FontSize="16" FontWeight="Black" Foreground="{StaticResource VexTextBrush}" />
                    <TextBlock Text="История обращений и чат доступны после входа. Поддержку на сайте можно открыть сразу."
                        FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource VexSecondaryTextBrush}" TextWrapping="Wrap" />
                    <Button Click="OnOpenAccountClick" AutomationProperties.AutomationId="SupportSignInButton" Content="Войти в VEX"
                        Style="{StaticResource VexProminentButtonStyle}" HorizontalAlignment="Stretch" MinHeight="44" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="ConversationPanel" Spacing="12" Visibility="Collapsed">
                <Border x:Name="TicketSummaryPanel" Padding="15" Background="#7508191D" CornerRadius="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TicketSubjectText" FontSize="16" FontWeight="Black" Foreground="{StaticResource VexTextBrush}"
                            Text="Обращение" TextWrapping="Wrap" />
                        <TextBlock x:Name="TicketMetaText" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VexMutedBrush}" Text="Статус: —" />
                        <TextBlock x:Name="TicketUpdatedText" FontSize="11" Foreground="{StaticResource VexSecondaryTextBrush}"
                            Text="Последнее обновление: —" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border x:Name="EmptyStatePanel" Padding="15" Background="#7508191D" CornerRadius="16">
                    <Grid ColumnSpacing="11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" Background="#2122D3EE" CornerRadius="8">
                            <FontIcon Glyph="&#xE8F2;" FontSize="17" Foreground="{StaticResource VexCyanBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Начните разговор" FontSize="13" FontWeight="Black" Foreground="{StaticResource VexTextBrush}" />
                            <TextBlock Text="Опишите проблему — команда VEX ответит здесь." FontSize="11" FontWeight="SemiBold"
                                Foreground="{StaticResource VexSecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ListView x:Name="MessagesList" AutomationProperties.AutomationId="SupportMessagesList" Background="Transparent"
                    SelectionMode="None" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="13,10" MaxWidth="460" HorizontalAlignment="{Binding Alignment}"
                                Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="14">
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11" FontWeight="Black" Foreground="{StaticResource VexCyanLightBrush}" Text="{Binding Sender}" />
                                        <TextBlock Grid.Column="1" FontSize="10" Foreground="{StaticResource VexMutedBrush}" Text="{Binding Delivery}" />
                                    </Grid>
                                    <TextBlock FontSize="13" Foreground="{StaticResource VexTextBrush}" Text="{Binding Body}"
                                        TextWrapping="WrapWholeWords" IsTextSelectionEnabled="True" />
                                    <TextBlock FontSize="10" Foreground="{StaticResource VexMutedBrush}" Text="{Binding CreatedAt}" />
                                    <Button Click="OnRetryMessageClick" Content="Повторить отправку" Tag="{Binding PendingId}"
                                        Visibility="{Binding RetryVisibility}" Style="{StaticResource VexGlassButtonStyle}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Border x:Name="ComposerPanel" Padding="15" Background="#7508191D" CornerRadius="16" Visibility="Collapsed">
                <StackPanel Spacing="11">
                    <TextBlock Text="Сообщение команде VEX" FontSize="16" FontWeight="Black" Foreground="{StaticResource VexTextBrush}" />
                    <TextBox x:Name="SubjectInput" Header="Тема" MaxLength="120" PlaceholderText="Например: не подключается VPN" />
                    <TextBox x:Name="MessageInput" AcceptsReturn="True" AutomationProperties.AutomationId="SupportMessageInput"
                        TextChanged="OnDraftChanged" MaxLength="4000" MinHeight="110" PlaceholderText="Опишите проблему…" TextWrapping="Wrap">
                        <TextBox.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnSendAcceleratorInvoked" />
                        </TextBox.KeyboardAccelerators>
                    </TextBox>
                    <CheckBox x:Name="AttachDiagnosticsCheckBox" AutomationProperties.AutomationId="AttachDiagnosticsCheckBox"
                        Content="Приложить обезличенную диагностику" FontSize="12" />
                    <TextBlock x:Name="DraftHintText" FontSize="11" Foreground="{StaticResource VexMutedBrush}"
                        Text="Ctrl+Enter — отправить сообщение" TextWrapping="Wrap" />
                    <Button x:Name="SendMessageButton" AutomationProperties.AutomationId="SendSupportMessageButton" Click="OnSendClick"
                        Content="Отправить сообщение" HorizontalAlignment="Stretch" MinHeight="44" Style="{StaticResource VexProminentButtonStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
