<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Match the app's DPAPI framework reference, rather than substituting a
         mock encryptor or introducing an unrelated package version. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <ProjectReference Include="../../src/Vex.Windows.Core/Vex.Windows.Core.csproj" />
    <ProjectReference Include="../../src/Vex.Windows.Client/Vex.Windows.Client.csproj" />
    <Compile Include="../../src/Vex.Windows.App/Services/ProtectedClientStateStore.cs" Link="ProtectedClientStateStore.cs" />
    <Compile Include="../../src/Vex.Windows.App/Services/UiPreviewContext.cs" Link="UiPreviewContext.cs" />
  </ItemGroup>
</Project>
