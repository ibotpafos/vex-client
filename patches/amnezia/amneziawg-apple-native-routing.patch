+        workQueue.async {
+            guard case .started(let handle, _) = self.state, self.routingParameters != nil else { completion(false); return }
+            let result = wgRouterUpdatePolicy(handle, parameters)
+            if result >= 0 { self.routingParameters = parameters }
+            completion(result >= 0)
+        }
+    }
